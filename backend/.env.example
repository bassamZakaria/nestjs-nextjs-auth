NODE_ENV=development
HOST=127.0.0.1
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/auth
# Required, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=
APP_ORIGIN=http://localhost:3000
# Access-token lifetime in seconds (1-86400). Default 900 (15 min). Set to 60 to watch the silent refresh happen a minute after signing in.
ACCESS_TOKEN_TTL_SECONDS=900
# Keep 0 unless a TLS-terminating reverse proxy in front of Next.js sets X-Forwarded-For; then set 1.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
